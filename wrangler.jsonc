// Worker só com arquivos estáticos: publica a Prova Solar em plataformasolar.org.br/prova/.
// O Workers Builds roda "npm ci && npm run build:plataforma", que gera dist-plataforma/prova/
// e copia plataforma/_headers para a raiz de dist-plataforma/. A demonstração no GitHub Pages
// continua com o build normal (.github/workflows/publicar.yml).
{
  "name": "prova-solar",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [ { "pattern": "plataformasolar.org.br/prova*", "zone_name": "plataformasolar.org.br" } ],
  "assets": { "directory": "./dist-plataforma", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
